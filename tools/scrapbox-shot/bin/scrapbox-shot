#!/bin/bash
#
# scrapbox-shot - take a screenshot, upload it to Gyazo, and create a Scrapbox
# (Cosense) page that holds the image.
#
# Depends only on what ships with macOS: bash, curl, screencapture, open, od.
#
# Exit codes:
#   0  page created
#   1  error
#   2  capture cancelled by the user (nothing to do)

set -uo pipefail

PROGNAME="scrapbox-shot"
VERSION="0.1.0"

CONFIG_FILE="${SCRAPBOX_SHOT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/scrapbox-shot/config}"

if [ -f "$CONFIG_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
fi

# Defaults. The config file (and pre-set environment variables) win over these.
: "${SCRAPBOX_PROJECT:=}"
: "${GYAZO_ACCESS_TOKEN:=}"
: "${CAPTURE_MODE:=interactive}"   # interactive | window | screen
# These three use `=` rather than `:=`: an empty value is a real choice
# (no archive, no tags, no prefix), not a request for the default.
: "${ARCHIVE_DIR=}"                # keep a local copy here when non-empty
: "${PAGE_TAGS=#screenshot}"
: "${TITLE_PREFIX=}"
: "${TITLE_DATE_FORMAT:=%Y-%m-%d %H:%M:%S}"
: "${DATE_LINK_FORMAT:=%Y/%m/%d}"
: "${OPEN_IN_BACKGROUND:=1}"
: "${NOTIFY:=1}"
: "${DETECT_FRONT_APP:=0}"         # osascript fallback; may trigger a TCC prompt
: "${SCRAPBOX_HOST:=https://scrapbox.io}"

TITLE=""
NOTE=""
IMAGE_FILE=""
APP_NAME=""
WINDOW_TITLE=""
DRY_RUN=0
DO_OPEN=1

usage() {
  cat <<EOF
$PROGNAME $VERSION

Usage: $PROGNAME [options]

Options:
  -m, --mode MODE      interactive (default) | window | screen
  -t, --title TITLE    page title (default: prefix + timestamp + app name)
  -n, --note TEXT      extra line written into the page body
  -f, --file PATH      use an existing image instead of capturing a new one
      --app NAME       name of the app the shot came from (used in title/body)
      --window TITLE   window title the shot came from (used in the body)
      --no-open        create the URL but do not open it (implies no page)
      --dry-run        print what would happen; no upload, no page
  -h, --help           show this help
  -v, --version        show the version

Config file: $CONFIG_FILE
EOF
}

log()  { printf '%s\n' "$*" >&2; }

# Arguments are passed to osascript as argv rather than spliced into the
# script text, so quotes in a title cannot break out.
notify() {
  [ "$NOTIFY" = "1" ] || return 0
  osascript - "$1" "$2" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run argv
  display notification (item 2 of argv) with title (item 1 of argv)
end run
APPLESCRIPT
}

die() {
  log "$PROGNAME: $*"
  notify "$PROGNAME" "$*"
  exit 1
}

# Percent-encode $1, leaving RFC 3986 unreserved characters alone. Works a byte
# at a time, so UTF-8 titles and notes survive intact.
urlencode() {
  printf '%s' "$1" | od -An -v -tx1 | tr ' ' '\n' | awk '
    BEGIN { for (i = 0; i < 128; i++) chr[sprintf("%02x", i)] = sprintf("%c", i) }
    /^[0-9a-f][0-9a-f]$/ {
      c = chr[$0]
      if (c != "" && c ~ /^[A-Za-z0-9._~-]$/) printf "%s", c
      else printf "%%%s", toupper($0)
    }'
}

# Pull a top-level string value out of a flat JSON object.
# `"url"` does not match `"permalink_url"` / `"thumb_url"` because the key is
# anchored on its opening quote.
json_string() {
  local key="$1" json="$2"
  printf '%s' "$json" \
    | sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p"
}

while [ $# -gt 0 ]; do
  case "$1" in
    -m|--mode)    CAPTURE_MODE="${2:-}"; shift 2 ;;
    -t|--title)   TITLE="${2:-}"; shift 2 ;;
    -n|--note)    NOTE="${2:-}"; shift 2 ;;
    -f|--file)    IMAGE_FILE="${2:-}"; shift 2 ;;
    --app)        APP_NAME="${2:-}"; shift 2 ;;
    --window)     WINDOW_TITLE="${2:-}"; shift 2 ;;
    --no-open)    DO_OPEN=0; shift ;;
    --dry-run)    DRY_RUN=1; shift ;;
    -h|--help)    usage; exit 0 ;;
    -v|--version) printf '%s %s\n' "$PROGNAME" "$VERSION"; exit 0 ;;
    *)            usage >&2; die "unknown option: $1" ;;
  esac
done

[ -n "$SCRAPBOX_PROJECT" ] || die "SCRAPBOX_PROJECT is not set (see $CONFIG_FILE)"
if [ "$DRY_RUN" = "0" ]; then
  [ -n "$GYAZO_ACCESS_TOKEN" ] || die "GYAZO_ACCESS_TOKEN is not set (see $CONFIG_FILE)"
fi

# ---------------------------------------------------------------- capture ---

TMPDIR_SHOT=""
cleanup() {
  [ -n "$TMPDIR_SHOT" ] && rm -rf "$TMPDIR_SHOT"
}
trap cleanup EXIT

if [ -n "$IMAGE_FILE" ]; then
  [ -f "$IMAGE_FILE" ] || die "no such file: $IMAGE_FILE"
else
  TMPDIR_SHOT="$(mktemp -d "${TMPDIR:-/tmp}/scrapbox-shot.XXXXXX")" \
    || die "could not create a temp directory"
  IMAGE_FILE="$TMPDIR_SHOT/shot.png"

  case "$CAPTURE_MODE" in
    interactive) screencapture -i "$IMAGE_FILE" ;;
    window)      screencapture -i -W "$IMAGE_FILE" ;;
    screen)      screencapture -m "$IMAGE_FILE" ;;
    *)           die "unknown capture mode: $CAPTURE_MODE" ;;
  esac

  # screencapture exits 0 on cancel in some macOS versions, so test the file.
  if [ ! -s "$IMAGE_FILE" ]; then
    log "$PROGNAME: capture cancelled"
    exit 2
  fi
fi

if [ -z "$APP_NAME" ] && [ "$DETECT_FRONT_APP" = "1" ]; then
  APP_NAME="$(osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' 2>/dev/null)"
fi

# ------------------------------------------------------------------ title ---

if [ -z "$TITLE" ]; then
  TITLE="${TITLE_PREFIX}$(date "+$TITLE_DATE_FORMAT")"
  [ -n "$APP_NAME" ] && TITLE="$TITLE - $APP_NAME"
fi
# "/" separates path segments in Scrapbox, and newlines cannot appear in a title.
TITLE="$(printf '%s' "$TITLE" | tr '/\n\r' '-  ')"
[ -n "$TITLE" ] || die "empty page title"

# ----------------------------------------------------------------- upload ---

if [ "$DRY_RUN" = "1" ]; then
  IMAGE_URL="https://i.gyazo.com/DRYRUN.png"
  PERMALINK_URL="https://gyazo.com/DRYRUN"
else
  # --form-string keeps a leading "@" or "<" in a value from being read as a
  # file reference; quoting the path keeps commas and semicolons in a filename
  # from being read as curl's own field separators.
  RESPONSE="$(curl -sS --max-time 60 \
    --form-string "access_token=$GYAZO_ACCESS_TOKEN" \
    --form-string "app=$PROGNAME" \
    --form-string "title=$TITLE" \
    -F "imagedata=@\"$IMAGE_FILE\"" \
    https://upload.gyazo.com/api/upload 2>&1)" \
    || die "Gyazo upload failed: $RESPONSE"

  IMAGE_URL="$(json_string url "$RESPONSE")"
  PERMALINK_URL="$(json_string permalink_url "$RESPONSE")"
  [ -n "$IMAGE_URL" ] || die "Gyazo returned no image url: $RESPONSE"
fi

# ------------------------------------------------------------------- body ---

BODY="[$IMAGE_URL]"
BODY="$BODY"$'\n'

if [ -n "$APP_NAME" ] || [ -n "$WINDOW_TITLE" ]; then
  SOURCE="$APP_NAME"
  if [ -n "$WINDOW_TITLE" ]; then
    [ -n "$SOURCE" ] && SOURCE="$SOURCE / $WINDOW_TITLE" || SOURCE="$WINDOW_TITLE"
  fi
  BODY="$BODY"$'\n'"from: $SOURCE"
fi

[ -n "$PERMALINK_URL" ] && BODY="$BODY"$'\n'"gyazo: $PERMALINK_URL"
BODY="$BODY"$'\n'"[$(date "+$DATE_LINK_FORMAT")]"
[ -n "$NOTE" ] && BODY="$BODY"$'\n'"$NOTE"
[ -n "$PAGE_TAGS" ] && BODY="$BODY"$'\n'"$PAGE_TAGS"

PAGE_URL="$SCRAPBOX_HOST/$(urlencode "$SCRAPBOX_PROJECT")/$(urlencode "$TITLE")?body=$(urlencode "$BODY")"

# ---------------------------------------------------------------- archive ---

if [ -n "$ARCHIVE_DIR" ] && [ "$DRY_RUN" = "0" ]; then
  mkdir -p "$ARCHIVE_DIR" \
    && cp "$IMAGE_FILE" "$ARCHIVE_DIR/$(date '+%Y%m%d-%H%M%S').png" \
    || log "$PROGNAME: could not archive into $ARCHIVE_DIR"
fi

# ------------------------------------------------------------------- open ---

if [ "$DRY_RUN" = "1" ]; then
  printf 'title: %s\n' "$TITLE"
  printf 'body:\n%s\n' "$BODY"
  printf 'url: %s\n' "$PAGE_URL"
  exit 0
fi

if [ "$DO_OPEN" = "1" ]; then
  if [ "$OPEN_IN_BACKGROUND" = "1" ]; then
    open -g "$PAGE_URL" || die "could not open the Scrapbox page"
  else
    open "$PAGE_URL" || die "could not open the Scrapbox page"
  fi
  notify "Scrapbox" "$TITLE"
fi

printf '%s\n' "$TITLE"
